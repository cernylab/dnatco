{
    "name": "rednatco",
    "version": "0.0.1",
    "description": "<PROTOTYPE>",
    "scripts": {
        "build": "npm run build-tsc && npm run build-webpack",
        "build-dev": "npm run build-tsc-dev && npm run build-webpack-dev",
        "watch": "concurrently -c \"green,blue\" --names \"tsc\" --kill-others \"npm:watch-tsc\" \"npm:watch-webpack\"",
        "watch-tsc": "tsc --watch --incremental",
        "watch-webpack": "webpack -w --mode development --stats minimal --config ./webpack.config.js",
        "build-tsc": "tsc --build tsconfig.json --incremental",
        "build-tsc-dev": "tsc --build tsconfig.development.json --incremental",
        "build-webpack": "webpack --mode production --config ./webpack.config.js",
        "build-webpack-dev": "webpack --mode development --config ./webpack.config.js",
        "lint": "eslint ./**/*.{ts,tsx}",
        "lint-fix": "eslint ./**/*.{ts,tsx} --fix",
        "test": "npm run lint"
    },
    "author": "DNATCO contributors",
    "contributors": [
    ],
    "license": "MIT",
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^5.10.2",
        "concurrently": "^7.1.0",
        "css-loader": "^6.6.0",
        "css-minimizer-webpack-plugin": "^3.4.1",
        "@typescript-eslint/parser": "^5.10.2",
        "eslint": "^8.8.0",
        "eslint-plugin-react": "^7.28.0",
        "mini-css-extract-plugin": "^2.5.3",
        "file-loader": "^6.2.0",
        "typescript": "^4.5.5",
        "webpack": "^5.68.0",
        "webpack-cli": "^4.9.2"
    },
    "dependencies": {
        "@types/react": "^17.0.0",
        "@types/react-dom": "^17.0.0",
        "@types/react-plotly.js": "^2.5.0",
        "@types/uuid": "^8.3.4",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "react-plotly.js": "^2.5.1",
        "rxjs": "^7.5.4",
        "tslib": "^2.3.1",
        "uuid": "^8.3.2"
    }
}
