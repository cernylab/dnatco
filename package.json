{
    "name": "rednatco",
    "version": "0.0.1",
    "description": "<PROTOTYPE>",
    "scripts": {
        "build": "npx @tailwindcss/cli -i ./assets/input.css -o ./assets/output.css && npm run build-tsc && npm run build-webpack",
        "build-dev": "npx @tailwindcss/cli -i ./assets/input.css -o ./assets/output.css && npm run build-tsc-dev && npm run build-webpack-dev",
        "build-lib": "npm run build-tsc-lib && npm run build-webpack-lib",
        "build-lib-dev": "npm run build-tsc-lib-dev && npm run build-webpack-lib-dev",
        "build-server": "npm run build-tsc-server && npm run build-webpack-server",
        "build-server-dev": "npm run build-tsc-server-dev && npm run build-webpack-server-dev",
        "watch": "concurrently -c \"green,blue\" --names \"tsc\" --kill-others \"npm:watch-tsc\" \"npm:watch-webpack\"",
        "watch-lib": "concurrently -c \"green,blue\" --names \"tsc\" --kill-others \"npm:watch-tsc-lib\" \"npm:watch-webpack-lib\"",
        "watch-tsc": "tsc --watch --project tsconfig-development.json",
        "watch-tsc-lib": "tsc --watch --project tsconfig-lib-development.json",
        "watch-webpack": "webpack -w --mode development --stats minimal --config ./webpack.config.js",
        "watch-webpack-lib": "webpack -w --mode development --stats minimal --config ./webpack-lib.config.js",
        "start-server": "webpack serve --mode development --stats minimal --config ./webpack.config.js",
        "serve-dev": "concurrently -c \"green,blue\" --names \"tsc\" --kill-others \"npm:watch-tsc\" \"npm:start-server\"",
        "build-tsc": "tsc --build tsconfig.json",
        "build-tsc-dev": "tsc --build tsconfig-development.json",
        "build-tsc-lib": "tsc --build tsconfig-lib.json",
        "build-tsc-lib-dev": "tsc --build tsconfig-lib-development.json",
        "build-tsc-server": "tsc --build tsconfig-server.json",
        "build-tsc-server-dev": "tsc --build tsconfig-server-development.json",
        "build-webpack": "webpack --mode production --config ./webpack.config.js",
        "build-webpack-dev": "webpack --mode development --config ./webpack.config.js",
        "build-webpack-lib": "webpack --mode production --config ./webpack-lib.config.js",
        "build-webpack-lib-dev": "webpack --mode development --config ./webpack-lib.config.js",
        "build-webpack-server": "webpack --mode production --config ./webpack-server.config.js",
        "build-webpack-server-dev": "webpack --mode development --config ./webpack-server.config.js",
        "lint": "eslint ./**/*.{ts,tsx}",
        "lint-fix": "eslint ./**/*.{ts,tsx} --fix",
        "test": "npm run lint",
        "profile": "webpack --profile --json",
        "tailwind": "npx @tailwindcss/cli -i ./assets/input.css -o ./assets/output.css --watch"
    },
    "author": "DNATCO contributors",
    "contributors": [],
    "license": "MIT",
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.17",
        "@types/crypto-js": "^4.2.2",
        "@types/express": "^5.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^18.15.3",
        "@types/react": "^18.0.21",
        "@types/react-dom": "^18.0.6",
        "@types/react-plotly.js": "^2.6.0",
        "@typescript-eslint/eslint-plugin": "^8.19.1",
        "@typescript-eslint/parser": "^8.19.1",
        "concurrently": "^9.1.2",
        "copy-webpack-plugin": "^14.0.0",
        "cors": "^2.8.5",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.3",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.6.3",
        "mini-css-extract-plugin": "^2.9.2",
        "node-loader": "^2.1.0",
        "process": "^0.11.10",
        "stream-browserify": "^3.0.0",
        "tailwindcss": "^4.0.17",
        "typescript": "=5.7.3",
        "webpack": "^5.97.1",
        "webpack-bundle-analyzer": "^4.8.0",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@pdf-lib/fontkit": "^1.1.1",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-select": "^2.2.6",
        "@tailwindcss/cli": "^4.0.17",
        "@types/dompurify": "^2.3.4",
        "@types/plotly.js": "^3.0.2",
        "@types/uuid": "^8.3.4",
        "assert": "^2.1.0",
        "better-sqlite3": "^12.4.6",
        "buffer": "^6.0.3",
        "bufferutil": "^4.0.9",
        "canvas": "^3.0.1",
        "canvg": "^4.0.2",
        "crypto-js": "^4.2.0",
        "dompurify": "^3.2.3",
        "express": "^4.21.2",
        "jsdom": "^26.0.0",
        "jsllka": "file:./jsllka",
        "pdf-lib": "^1.17.1",
        "plotly.js-cartesian-dist": "^3.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-plotly.js": "^2.6.0",
        "react-router": "^7.7.1",
        "rxjs": "^7.8.1",
        "style-loader": "^3.3.3",
        "tscif": "file:./tscif",
        "tslib": "^2.5.0",
        "tspdb": "file:./tspdb",
        "utf-8-validate": "^6.0.3",
        "uuid": "^14.0.0",
        "webpack-dev-server": "^5.2.3"
    }
}
