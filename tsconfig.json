{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "lib": [ "es6", "es2016", "dom" ],
        "module": "es2020",
        "target": "es6",
        "jsx": "react",

        "alwaysStrict": true,
        "noImplicitThis": true,
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,

        "noUnusedLocals": true,
        "esModuleInterop": true,

        "moduleResolution": "node",

        "outDir": "lib",
        "rootDirs": [ "src", "tscif" ],

        "baseUrl": ".",
        "paths": {
            "tscif": [ "tscif/src" ]
        }
    },
    "include": [ "src/**/*" ]
}
