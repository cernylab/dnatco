{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "incremental": true,
        "module": "CommonJS",
        "target": "es5",

        "alwaysStrict": true,
        "noImplicitThis": true,
        "strict": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,

        "noUnusedLocals": true,
        "esModuleInterop": true,

        "moduleResolution": "node",
        "inlineSourceMap": true,
        "inlineSources": true,

	"skipLibCheck": true,

        "outDir": "lib/server",
        "rootDirs": [
            "src",
            "tscif/src",
            "tspdb/src"
        ],

        "baseUrl": ".",
    },
    "include": [ "src/server/**/*" ],
}
